<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ : ni sauvegarde dans le cloud, ni transfert vers un nouveau téléphone.
  Les données de santé ne sortent que par l'export JSON, à la demande.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
